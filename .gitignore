# 비밀 정보 — 절대 커밋 금지
.env
service-account.json
*.json.bak

# Node.js (Astryx 패키지는 루트 로컬 레퍼런스용 — 토큰값만 차용, 런타임 의존성 아님)
node_modules/
package.json
package-lock.json

# 예외: coaching brain/ 의 package.json 은 PPT 빌드 스크립트의 진짜 의존성 선언 — 추적 필요
!coaching brain/package.json

# DB 파일 (로컬 SQLite + 백업)
codm.db
codm.db.backup
codm.db.backup_*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# 가상환경
venv/
.venv/
env/
ENV/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 아카이브 (백업·원본 데이터 보관)
_archive/

# 백업/임시
*.bak
*.bak.*
base.html.bak

# CSV (마이그레이션 원본, 저장소에 불필요)
*.csv

# 로그
*.log

# 원본 make.com 블루프린트 (참고용이지만 저장소 정리를 위해 제외)
*.blueprint*.json

# 전사문 샘플 (실제 코칭 VOD 세션 — 민감, 로컬만 보관)
# 도메인 컨텍스트 갱신 시 scripts/refresh_domain_context.py가 여기를 스캔
전사문샘플*.md
전사문*.md
transcripts/
transcript_samples/
.obsidian/

# 코칭 브레인 — Obsidian 개인 작업공간 상태 (지식은 커밋, 설정은 제외)
coaching brain/.obsidian/workspace.json
coaching brain/.obsidian/graph.json

# PPT 빌드 산출물 (스크립트로 재생성 가능 — 산출물 자체는 커밋하지 않음)
# make_pptx.py / make_pptx_roles.js 로 빌드
coaching brain/*.pptx
coaching brain/*.pdf
coaching brain/slide-*.jpg
backups/
reprocess_state.json
reprocess_log.txt
