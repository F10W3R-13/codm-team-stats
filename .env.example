# 이 파일을 복사해서 .env 로 만든 뒤 실제 값으로 채우세요.
# (README.md 의 '사전 준비' 항목 참고)

# 디스코드 봇 토큰
# https://discord.com/developers/applications -> 본인 봇 -> Bot -> Reset Token / Copy
DISCORD_BOT_TOKEN=여기에_봇_토큰

# OpenAI API 키
# https://platform.openai.com/api-keys
OPENAI_API_KEY=여기에_openai_api_키

# 구글 서비스 계정 — 둘 중 하나만 채운다.
#
# [로컬 개발] 파일 경로 방식 (기본)
#   발급받은 JSON 키를 이 폴더에 service-account.json 이름으로 저장 후 아래 경로 사용.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
#
# [배포] JSON 내용 통째로 방식 (Railway 등 파일 업로드가 안 되는 환경)
#   service-account.json 파일 내용 전체를 한 줄로 복사해서 붙여넣는다.
#   (큰따옴표 이스케이프 주의 — JSON 통째로 그대로 붙여도 됨)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

# ── 배포(Railway) 전용 ─────────────────────────────────────────────────────
# DATABASE_URL 은 Railway 가 PostgreSQL 서비스를 추가하면 자동으로 주입됨 (직접 입력 X).
# PORT 도 Railway 가 자동 주입함 (직접 입력 X).
