# 이 파일을 복사해서 .env 로 만든 뒤 실제 값으로 채우세요.
# (README.md 의 '사전 준비' 항목 참고)

# 디스코드 봇 토큰
# https://discord.com/developers/applications -> 본인 봇 -> Bot -> Reset Token / Copy
DISCORD_BOT_TOKEN=여기에_봇_토큰

# OpenAI API 키
# https://platform.openai.com/api-keys
OPENAI_API_KEY=여기에_openai_api_키

# 구글 서비스 계정 JSON 키 파일 경로 (다운로드한 키 파일 위치)
# 예) ./service-account.json
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
